{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/interview-preassignments.js": {"maxDuration": 240},
    "api/interview-live-socket.js": {
      "maxDuration": 800,
      "memory": 1024,
      "regions": ["syd1"]
    },
    "api/interview-live-cleanup.js": {
      "maxDuration": 300,
      "regions": ["syd1"]
    },
    "api/interview-live.js": {
      "maxDuration": 60
    },
    "api/interview-native.js": {
      "maxDuration": 60
    },
    "api/criminal-law-ox.js": {
      "regions": ["syd1"]
    }
  },
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:file(shared|student|teacher|teacher-grades|teacher-fitness|teacher-students|teacher-settings|teacher-penalties|teacher-seats|question-board|feedback-hub|curriculum-data|curriculum-admin|criminal-law-ox|criminal-law-ox-admin|study-character|study-shop|student-rewards|study-record-share|study-cafe-bot-admin|app|supabase).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
