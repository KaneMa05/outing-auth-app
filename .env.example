TEACHER_USERNAME=admin
TEACHER_PASSWORD=change-this-teacher-password
TEACHER_SESSION_SECRET=change-this-long-random-session-secret
STUDENT_MANAGER_USERNAME=manager
STUDENT_MANAGER_PASSWORD=qwer1234!
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Interview social sign-in. Apple keys remain on the server; enable after DB and Apple setup.
INTERVIEW_APPLE_ENABLED=false
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Generate 32 random bytes as 64 lowercase hex characters; keep it for stored grant revocation.
APPLE_TOKEN_ENCRYPTION_KEY=
# Optional, server-only: create one Slack Incoming Webhook for each channel.
# Empty values disable notifications for that channel.
# Channel: 필기반-앱
SLACK_WRITTEN_APPLICATION_WEBHOOK_URL=
# Channel: 면접반-앱
SLACK_INTERVIEW_APPLICATION_WEBHOOK_URL=
# Enable only after installing 20261014025654_study_cafe_snapshot_bundle.sql.
# Server-only switch; false keeps the previous read path.
STUDY_CAFE_SNAPSHOT_BUNDLE_ENABLED=false
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
SOLAPI_API_KEY=YOUR_SOLAPI_API_KEY
SOLAPI_API_SECRET=YOUR_SOLAPI_API_SECRET
SOLAPI_API_BASE_URL=https://api.solapi.com
SOLAPI_KAKAO_PF_ID=YOUR_SOLAPI_KAKAO_CHANNEL_PROFILE_ID
SOLAPI_KAKAO_TEMPLATE_ID=YOUR_SOLAPI_ALIMTALK_TEMPLATE_ID
SOLAPI_SENDER_NUMBER=YOUR_REGISTERED_SENDER_NUMBER
PHONE_VERIFICATION_TOKEN_SECRET=change-this-to-a-random-value-at-least-32-characters

# OpenAI mock interview APIs. Server only; never copy these values into config.js or iOS.
# Existing per-mode false flags override the shared switch.
OPENAI_API_KEY=
INTERVIEW_OPENAI_ENABLED=false
INTERVIEW_EXAM_VALIDATION_ENABLED=false
INTERVIEW_JOB_EXAM_ENABLED=false
INTERVIEW_PERSONALITY_ENABLED=false
INTERVIEW_LIVE_ENABLED=false
INTERVIEW_NATIVE_ENABLED=false
INTERVIEW_MOCK_REPORT_ENABLED=false
INTERVIEW_JOB_EXAM_MODE=openai
INTERVIEW_PERSONALITY_MODE=openai
INTERVIEW_MOCK_REPORT_MODE=openai
INTERVIEW_TRANSCRIPTION_MODEL=gpt-transcribe
INTERVIEW_EXAM_JUDGE_MODEL=gpt-6.1-sol
INTERVIEW_EXAM_VERIFIER_MODEL=gpt-6-astra
INTERVIEW_PERSONALITY_ANALYSIS_MODEL=gpt-6.1-sol
INTERVIEW_LIVE_MODEL=gpt-live-1
INTERVIEW_LIVE_FOLLOWUP_MODEL=gpt-6.1-sol
INTERVIEW_MOCK_REPORT_MODEL=gpt-6.1-sol
INTERVIEW_LIVE_TRANSPORT=vercel
INTERVIEW_LIVE_RUNTIME_SECONDS=800
INTERVIEW_LIVE_WORKER_SECRET=
CRON_SECRET=
