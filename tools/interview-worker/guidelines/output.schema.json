{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "answer", "source_refs", "experience_coverage", "missing"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "status": {"type": "string", "enum": ["ready", "needs_input"]},
    "answer": {"type": "string", "maxLength": 8000},
    "source_refs": {
      "type": "array", "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "quote", "answer_excerpt"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "quote": {"type": "string", "minLength": 1, "maxLength": 2000},
          "answer_excerpt": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "experience_coverage": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["experience_id", "answer_excerpt"],
        "properties": {
          "experience_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "answer_excerpt": {"type": "string", "minLength": 1, "maxLength": 3000}
        }
      }
    },
    "missing": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
