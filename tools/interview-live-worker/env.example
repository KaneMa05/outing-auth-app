# Server only. Copy missing settings to the repository .env.local for local tests.
# Never copy this entire file over existing settings. Never commit real credentials.
# For the Vercel app transport set vercel, runtime 800, and a separate CRON_SECRET.
INTERVIEW_LIVE_TRANSPORT=worker
INTERVIEW_LIVE_RUNTIME_SECONDS=800
CRON_SECRET=
OPENAI_API_KEY=
INTERVIEW_LIVE_FOLLOWUP_MODEL=gpt-6-astra
INTERVIEW_LIVE_WORKER_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTERVIEW_LIVE_SPOOL=
INTERVIEW_LIVE_BIND=127.0.0.1
PORT=3091
INTERVIEW_LIVE_WORKER_URL=http://127.0.0.1:3091
INTERVIEW_LIVE_ENABLED=false
